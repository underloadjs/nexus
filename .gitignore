# Rust build artifacts normally land in the repo-root .rust/target (the root
# .cargo/config.toml sets target-dir), so nothing here is expected except when
# someone builds with an explicit --target-dir.
target/
/rust/target/

# wasm-bindgen output: regenerated by `yarn build:wasm` (cargo + wasm-bindgen-cli).
# The .wasm and its glue are build products, not sources, and would churn every
# commit otherwise.
pkg/
dist/

# Artifact spill from a local `yarn start` run (NEXUS_ARTIFACT_ROOT default).
var/

# Same spill when the hub is launched from inside this package: the built-in
# default is `Temp/nexus/artifacts`, which is relative to the working directory,
# so running `yarn start` here would otherwise leave untracked spill in the tree.
# It also covers the fallback of `io::test_scratch` (test-only scratch normally
# resolves to the repo-root `Temp/nexus-tests/`, per root AGENTS.md; if this
# package is checked out on its own, that falls back to `Temp/` in here).
Temp/

# Node side of the WASM boundary.
node_modules/
*.log
